{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/schemas/settings.schema.json",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run verify:*)",
      "Bash(node -c:*)",
      "Bash(npx vitest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(scripts/hooks/*:*)"
    ],
    "deny": [
      "Bash(gh pr merge --admin:*)",
      "Bash(gh *--admin*)"
    ]
  }
}
